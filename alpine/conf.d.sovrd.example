# /etc/conf.d/sovrd — Sovren node service config (Alpine / OpenRC, plain-config).
#
# Read by /etc/init.d/sovrd. It configures the OpenRC service and the one-time
# snapshot bootstrap; the node's OWN config is config.toml / app.toml under
# $SOVR_HOME (edit those for peering, listeners, pruning, etc.).
#
# Edit, then: rc-service sovrd restart
#
# Values are single-quoted because the service sources this file as root.
# "replace"/"required"/"todo"/"placeholder" are treated as unset on mainnet.

# --- node home -------------------------------------------------------------
SOVR_HOME='/home/sovr/.sovr'
CHAIN_ID='sovr-1'
DEPLOYMENT_ENVIRONMENT='mainnet'

# --- snapshot bootstrap (fresh node; no-op once data/ exists) --------------
# From-genesis sync is NOT viable on sovr-1, so a fresh node restores a signed
# archive snapshot first, then blocksyncs the gap to head. The two anchors must
# be DISTINCT (the restore cross-checks the signed block_hash against both and
# fails closed). `alpine/install.sh` fills these in for --environment mainnet.
SNAPSHOT_RESTORE='true'
SNAPSHOT_BASEURL='https://svrn-chain-snapshots-mainnet.nyc3.digitaloceanspaces.com/snapshots'
SNAPSHOT_NETWORK='mainnet'
SNAPSHOT_COSIGN_PUBKEY='MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEv6XtLWy4H3IhmiLMUXEbRCeWswmXS8Y3xuNHo96Bwt2TbZSnwxnn4sHbl1/2cTH+b85pb/zGRIfURBad2ZOpfA=='
SNAPSHOT_ANCHORS='https://rpc.sovrchain.net,https://rpc2.sovrchain.net'
# cosign release tag fetched by restore-snapshot.sh if cosign isn't installed.
SNAPSHOT_COSIGN_VERSION='v2.4.1'
